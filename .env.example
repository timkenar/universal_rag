# Copy to `.env` and fill in as needed. All values are optional — the system
# runs fully offline with the defaults.

# --- Providers ---
# embedding_provider: local | gemini   (default: local)
EMBEDDING_PROVIDER=local
# llm_provider: none | gemini | anthropic | ollama | openai | nvidia | groq | together | openrouter
#   (default: none = offline extractive answers)
LLM_PROVIDER=none

# --- Gemini (LLM_PROVIDER=gemini) ---
# GEMINI_API_KEY=your-key-here
# LLM_MODEL=gemini-2.0-flash

# --- Anthropic / Claude (LLM_PROVIDER=anthropic) ---
# Uses the official Anthropic SDK (pip install anthropic).
# ANTHROPIC_API_KEY=sk-ant-your-key
# ANTHROPIC_MODEL=claude-opus-4-8       # default; e.g. claude-sonnet-5, claude-haiku-4-5

# --- OpenAI-compatible providers (openai | nvidia | groq | together | openrouter) ---
# Set LLM_PROVIDER above to one of these, put the model name in LLM_MODEL, and
# provide the matching API key. The base URL is auto-selected from the provider
# name; override it with OPENAI_BASE_URL for a custom / local endpoint.
#
# OpenAI:  LLM_PROVIDER=openai   LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your-openai-key
#
# NVIDIA (https://build.nvidia.com/models):
#   LLM_PROVIDER=nvidia   LLM_MODEL=meta/llama-3.1-70b-instruct
# NVIDIA_API_KEY=nvapi-your-key
#
# Groq:       LLM_PROVIDER=groq        LLM_MODEL=llama-3.3-70b-versatile   (GROQ_API_KEY=...)
# Together:   LLM_PROVIDER=together     LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo  (TOGETHER_API_KEY=...)
# OpenRouter: LLM_PROVIDER=openrouter   LLM_MODEL=anthropic/claude-3.5-sonnet  (OPENROUTER_API_KEY=...)
#
# Custom / local (vLLM, LM Studio, any OpenAI-compatible server):
#   LLM_PROVIDER=openai   OPENAI_BASE_URL=http://localhost:8000/v1   OPENAI_API_KEY=not-needed

# --- Ollama (LLM_PROVIDER=ollama; a native local server, not OpenAI-compatible) ---
# OLLAMA_MODEL=llama3.2
# OLLAMA_HOST=http://localhost:11434

# --- Durable memory layer ---
# Persists facts learned in chat across sessions, retrieved alongside documents.
# memory_provider: obsidian | supermemory | none   (default: obsidian)
MEMORY_PROVIDER=obsidian
# Auto-save each answered chat turn as a memory (default: true).
MEMORY_AUTOSAVE=true
# Where the offline Obsidian vault lives (default: ./memory_vault).
# OBSIDIAN_VAULT_DIR=./memory_vault
#
# supermemory backend (MEMORY_PROVIDER=supermemory; pip install supermemory).
# Self-host keeps data local; a bare API key uses the cloud (data leaves the box).
#   Self-host:  npx supermemory local  ->  SUPERMEMORY_BASE_URL=http://localhost:6767
# SUPERMEMORY_BASE_URL=http://localhost:6767
# SUPERMEMORY_API_KEY=your-key           # cloud only
# SUPERMEMORY_USER_ID=default            # container/namespace for your memories

# --- API server (python main.py serve) ---
JARVIS_PORT=8000

# --- OCR (scanned PDFs / images) ---
# auto = OCR only pages with no text layer (default) | off = never | force = every page
OCR_MODE=auto
