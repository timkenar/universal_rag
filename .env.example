# Copy to `.env` and fill in as needed. All values are optional — the system
# runs fully offline with the defaults.

# --- Providers ---
# embedding_provider: local | gemini   (default: local)
EMBEDDING_PROVIDER=local
# llm_provider: none | gemini | ollama  (default: none = extractive answers)
LLM_PROVIDER=none

# --- Gemini (only needed if a provider above is set to "gemini") ---
# GEMINI_API_KEY=your-key-here
# LLM_MODEL=gemini-2.0-flash

# --- Ollama (only needed if LLM_PROVIDER=ollama) ---
# OLLAMA_MODEL=llama3.2
# OLLAMA_HOST=http://localhost:11434

# --- API server (python main.py serve) ---
JARVIS_PORT=8000
